GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=2080
OMNIROUTE_URL=http://127.0.0.1:20128
DATABASE_PATH=./data/gateway.db
API_KEY_PEPPER=replace-at-runtime-with-32-or-more-characters
INTERNAL_READY_TOKEN=replace-at-runtime-with-32-or-more-characters
LOG_LEVEL=info
UPSTREAM_CONCURRENCY=4
REQUEST_TIMEOUT_MS=120000
DAILY_BUDGET_UNITS=100000
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_ENTRIES=2048
STREAM_IDLE_TIMEOUT_MS=60000
SQLITE_CACHE_KIB=4096
RETENTION_DAYS=90
MAINTENANCE_INTERVAL_MS=3600000
# Enable only when the gateway sits behind the local cloudflared tunnel.
TRUST_PROXY=false
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
READY_UPSTREAM_TIMEOUT_MS=2000
# Must stay at or below UPSTREAM_CONCURRENCY.
TENANT_MAX_CONCURRENT=2
TENANT_LIMIT_MAX_ENTRIES=512
