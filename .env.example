# LeuwongRR Gateway — environment contract
#
# On the VPS this file lives at /opt/leuwongrr-gateway/config/gateway.env,
# owned root:root with mode 600. scripts/deploy.sh refuses to deploy otherwise.
# Never commit a filled copy: scan:secrets fails the build if you do.

# ---------------------------------------------------------------------------
# Origin. Cloudflare Tunnel is the only public path, so the process binds to
# loopback. deploy.sh hard-fails on any other host or port.
# ---------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=2080
OMNIROUTE_URL=http://127.0.0.1:20128
PUBLIC_BASE_URL=https://api.leuwongrr.cloud

# ---------------------------------------------------------------------------
# Persistence and secrets. Both secrets must be at least 32 characters.
# Generate with: openssl rand -hex 32
# Rotating API_KEY_PEPPER invalidates every issued API key.
# ---------------------------------------------------------------------------
DATABASE_PATH=/opt/leuwongrr-gateway/data/gateway.db
API_KEY_PEPPER=replace-with-openssl-rand-hex-32
INTERNAL_READY_TOKEN=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Capacity. TENANT_MAX_CONCURRENT must not exceed UPSTREAM_CONCURRENCY and
# RATE_LIMIT_BURST must not exceed RATE_LIMIT_RPM; config validation rejects
# the process at startup if either rule is broken.
# ---------------------------------------------------------------------------
UPSTREAM_CONCURRENCY=4
TENANT_MAX_CONCURRENT=2
TENANT_LIMIT_MAX_ENTRIES=512
REQUEST_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=60000
READY_UPSTREAM_TIMEOUT_MS=2000
DAILY_BUDGET_UNITS=100000
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_ENTRIES=2048
SQLITE_CACHE_KIB=4096
RETENTION_DAYS=90
MAINTENANCE_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Proxy trust. Set TRUST_PROXY=true only because Cloudflare terminates TLS in
# front of the tunnel; the client IP is then read from the header below.
# ---------------------------------------------------------------------------
TRUST_PROXY=true
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# ---------------------------------------------------------------------------
# Console. WEB_DIST_PATH points at the console bundle shipped inside the
# release artifact; if it is missing the dashboards answer 503 console_not_built.
# ---------------------------------------------------------------------------
CONSOLE_ENABLED=true
WEB_DIST_PATH=./dist/public
SESSION_COOKIE_NAME=lwrr_session
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Member login: one-time code by email. OTP_DELIVERY=log prints the code to the
# service log (development only). With OTP_DELIVERY=webhook both webhook values
# are mandatory.
# ---------------------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_DELIVERY=log
# OTP_WEBHOOK_URL=https://mail-relay.example.com/send
# OTP_WEBHOOK_TOKEN=replace-with-relay-token

# ---------------------------------------------------------------------------
# Admin access. /admin* additionally requires a Cloudflare Access JWT on top of
# the application role. Both values are required together when the console is
# enabled. ACCESS_AUD is the Application Audience tag of the self-hosted app.
# ---------------------------------------------------------------------------
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience-tag

# ---------------------------------------------------------------------------
# Social login. Each client id/secret pair is all-or-nothing. Redirect URI is
# PUBLIC_BASE_URL + /console/api/auth/callback/<provider>.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Cryptomus. Merchant id and payment API key are required together. The webhook
# signature is MD5(base64(body) + api key); never expose the key to the browser.
# ---------------------------------------------------------------------------
CRYPTOMUS_API_URL=https://api.cryptomus.com
# CRYPTOMUS_MERCHANT_ID=
# CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_TIMEOUT_MS=15000
