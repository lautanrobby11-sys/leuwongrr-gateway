{
  "name": "@leuwongrr/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src tests scripts eslint.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:conventions": "node scripts/check-conventions.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate": "npm run check:conventions && npm run scan:secrets && npm run lint && npm run typecheck && npm test",
    "ci:local": "npm run validate && npm run build && bash -n scripts/*.sh && bash scripts/build-release.sh $(git rev-parse HEAD)",
    "keys": "node dist/cli/keys.js",
    "keys:dev": "tsx src/cli/keys.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.4.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.33",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
