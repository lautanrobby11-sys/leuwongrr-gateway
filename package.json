{
  "name": "@leuwongrr/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:conventions": "node scripts/check-conventions.mjs",
    "validate": "npm run check:conventions && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.12",
    "pino": "^9.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.33",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
