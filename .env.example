# LeuwongRR Gateway production environment contract
# Install as /opt/leuwongrr-gateway/config/gateway.env, root:root mode 0600.
#
# Every field that needs a real value, and every credential, is the literal
# REPLACE_ME with no exceptions: `grep -n REPLACE_ME` is therefore the complete
# list of remaining work, which is what both the bootstrap script and the README
# instruct. A field spelled any other way was silently outside that list and
# shipped as a plausible-looking example value. The only illustrative values left
# are commented-out non-secret settings whose format needs showing.
#
# For a secret, REPLACE_ME is also too short to satisfy its own validation rule,
# so an unedited copy refuses to boot and names the field. The few non-secret
# fields marked below are long enough to pass validation, so they fail at the
# dependency they configure instead; the comment on each says so.
NODE_ENV=production
GATEWAY_HOST=127.0.0.1
# The deploy script asserts this exact value and the Cloudflare Tunnel ingress is
# configured for it, so changing the port needs both.
GATEWAY_PORT=2080
OMNIROUTE_URL=http://127.0.0.1:20128
# OmniRoute runs with REQUIRE_API_KEY=true, so /v1/* upstream calls are rejected
# with 401 AUTH_002 unless the gateway presents this credential. Issue it from
# the OmniRoute dashboard; production refuses to boot without it. Never commit,
# log, or paste the value anywhere.
OMNIROUTE_API_KEY=REPLACE_ME
PUBLIC_BASE_URL=https://api.leuwongrr.cloud
DATABASE_PATH=/opt/leuwongrr-gateway/data/gateway.db
# openssl rand -hex 32
API_KEY_PEPPER=REPLACE_ME
# openssl rand -hex 32, and must differ from every other token here.
INTERNAL_READY_TOKEN=REPLACE_ME
LOG_LEVEL=info
UPSTREAM_CONCURRENCY=4
TENANT_MAX_CONCURRENT=2
TENANT_LIMIT_MAX_ENTRIES=512
REQUEST_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=60000
READY_UPSTREAM_TIMEOUT_MS=2000
DAILY_BUDGET_UNITS=100000
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_ENTRIES=2048
SQLITE_CACHE_KIB=4096
RETENTION_DAYS=90
MAINTENANCE_INTERVAL_MS=3600000
TRUST_PROXY=true
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# Snapshot values are host-only. AGE_RECIPIENT is public; the dead-man URL is a
# bearer capability and must never be committed, logged, or pasted into chat.
# Configure the external check for a 24h period plus 12h grace.
# Not read by the gateway process: scripts/backup.sh refuses to run without it,
# and `age -r REPLACE_ME` fails before an archive is written, so an unedited
# value cannot produce a snapshot nobody can decrypt.
AGE_RECIPIENT=REPLACE_ME
BACKUP_KEEP=14
# SNAPSHOT_HEALTHCHECK_URL=https://external-deadman.example/ping-id
# ADR-011: observability is opt-in and separately credentialed. When enabled,
# INTERNAL_METRICS_TOKEN is required and must differ from INTERNAL_READY_TOKEN.
# Scrape over the tunnel or loopback only; never publish /metrics.
METRICS_ENABLED=false
# INTERNAL_METRICS_TOKEN=REPLACE_ME
CONSOLE_ENABLED=true
# ADR-011: state-changing console calls require an allowed Origin. PUBLIC_BASE_URL
# is always allowed; list extra origins here only if the console is served from a
# second hostname. Comma separated, absolute, https in production.
# CONSOLE_ALLOWED_ORIGINS=https://console.leuwongrr.cloud
WEB_DIST_PATH=./dist/public
SESSION_COOKIE_NAME=lwrr_session
SESSION_TTL_HOURS=12
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Production is fail-closed: log/dev-code delivery is rejected at startup.
OTP_DELIVERY=webhook
# REPLACE_ME is not a URL, so loadConfig() rejects it by name while
# OTP_DELIVERY=webhook. Point it at the relay that sends the sign-in code.
OTP_WEBHOOK_URL=REPLACE_ME
OTP_WEBHOOK_TOKEN=REPLACE_ME
# Both Access values are public identifiers, not secrets, and both are long
# enough to pass their own validation rule — an unedited pair therefore boots and
# fails at the edge instead, with access_issuer_mismatch or
# access_audience_mismatch on the first /admin request. Copy them from the Access
# application: the team domain, then its audience tag.
ACCESS_TEAM_DOMAIN=REPLACE_ME
ACCESS_AUD=REPLACE_ME
CRYPTOMUS_API_URL=https://api.cryptomus.com
CRYPTOMUS_TIMEOUT_MS=15000
# Optional all-or-nothing pairs. Commented out so the file boots without them;
# every value still reads REPLACE_ME, so uncommenting a group without editing it
# is caught rather than sent to the provider.
# GOOGLE_CLIENT_ID=REPLACE_ME
# GOOGLE_CLIENT_SECRET=REPLACE_ME
# DISCORD_CLIENT_ID=REPLACE_ME
# DISCORD_CLIENT_SECRET=REPLACE_ME
# TELEGRAM_BOT_TOKEN=REPLACE_ME
# TELEGRAM_BOT_USERNAME=REPLACE_ME
# CRYPTOMUS_MERCHANT_ID=REPLACE_ME
# CRYPTOMUS_PAYMENT_API_KEY=REPLACE_ME
# LEUWONGRR_WEBHOOK_SECRET=REPLACE_ME   # HMAC secret for leuwongrr.online payment webhooks
