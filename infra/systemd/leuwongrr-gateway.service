[Unit]
Description=LeuwongRR LLM Gateway
# OmniRoute runs as a Docker container on this host, so the container runtime
# must be up before the gateway starts. Without this ordering the gateway can
# win the race after a reboot and stay up but never ready, because its upstream
# is unreachable. Wants= keeps this soft: a host without Docker still starts.
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=leuwongrr-gateway
Group=leuwongrr-gateway
WorkingDirectory=/opt/leuwongrr-gateway/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
EnvironmentFile=/opt/leuwongrr-gateway/config/gateway.env
ExecStart=/usr/bin/node /opt/leuwongrr-gateway/current/dist/main.js
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# Must stay false. V8 compiles JavaScript to machine code at runtime and has to
# mark freshly written pages executable; MemoryDenyWriteExecute makes that
# mprotect fail with EPERM. V8 only tolerates ENOMEM there, so any other errno
# trips a fatal CHECK and the process core-dumps shortly after start. Setting
# this to true will crash-loop the gateway, not harden it.
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/leuwongrr-gateway/data /opt/leuwongrr-gateway/logs /opt/leuwongrr-gateway/runtime
UMask=0077
LimitNOFILE=8192
TasksMax=96
MemoryHigh=256M
MemoryMax=384M
CPUQuota=75%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
